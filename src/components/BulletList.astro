---
// Lead-in + parallel items: a tight, equal-weight set the reader takes in together (eligibility,
// what is included, what to bring). Introduce it with a stem line ending in a colon, keep the
// items parallel and roughly equal in length, and hold it to at least three and at most seven
// (fewer than three is a sentence, not a list; more than seven stops being scannable).
//
// Bullets are for an UNORDERED set. `ordered` switches to quiet mono numerals, but only for a
// genuinely ranked or numbered reference list — a process the reader follows in ORDER is a
// Stepper, not this, and choices/options are never numbered (a reader reads a number as "do all").
// `marker` picks the bullet:
//   dot     round, hairline colour. THE DEFAULT. Most lists on this site are reference sets - what
//           is included, what you need, conditions that each stand alone - and a quiet marker lets
//           the items read as equals.
//   accent  round, Heritage Maroon. For a set that genuinely needs lifting off the page. Reach for
//           it deliberately: DESIGN.md reserves maroon for actions, so a maroon list is spending
//           the accent colour and should be earning it.
//
// The original 8x1px maroon DASH was removed on 30 Jul 2026 and is not a variant. It applied the
// accent to every list by default, which meant no list could be emphasised relative to another -
// everything was lifted, so nothing was. Only five call sites existed, all reviewed in that change.
//
// Same shape and colour as the `.vlist` utility in global.css, which is this treatment for a list
// nested INSIDE a component (a fact value in Credentials). This component is how you get it in an
// MDX body, where raw classes are not allowed.
interface Props {
  items: string[];
  leadIn?: string;
  ordered?: boolean;
  marker?: 'dot' | 'accent';
}
const { items, leadIn, ordered = false, marker = 'dot' } = Astro.props;
const Tag = ordered ? 'ol' : 'ul';
---
<div class="blist">
  {leadIn && <p class="blist-lead">{leadIn}</p>}
  <Tag class:list={['blist-items', ordered && 'blist-items--num', marker === 'accent' && !ordered && 'blist-items--accent']}>
    {items.map((it) => <li set:html={it} />)}
  </Tag>
</div>
