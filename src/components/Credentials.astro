---
import Placeholder from './Placeholder.astro';
import { imageUrl } from '../lib/images';
import type { Person } from '../types/course';
// Two-profile E-E-A-T block: developer + reviewer. Grayscale portraits; if a portrait is missing,
// keep the FPO placeholder and do NOT add `image` to Person schema.
//
// `org` fills the DEVELOPER slot with an organisation instead of a person. On an asqa-accredited
// page the course is developed and owned by the RTO partner (not any ABE Education person, see
// kb/rules/authority-model.md §6), so the developer card is the RTO. It renders FIRST, so the
// pairing reads developer -> reviewer exactly as the two-person version did.
//
// ONE ANATOMY FOR ALL THREE CARD TYPES (RTO, developer, reviewer), reworked 30 Jul 2026:
//   visual -> name -> role -> facts table -> prose -> links -> verified
// The facts table is the change. Every card previously rendered its facts as a run-on line with a
// bold split at the first comma, which read as prose, not as data: "Registered training
// organisation, RTO 31193". `.fxrow` below and PartnerDisclosure's `.pl-frow` are the same shape and
// are kept in step deliberately - both components render the same partner record, so a change to
// one is a change to both.
//
// LABELS ARE EYEBROWS, ABOVE THEIR VALUE, not a fixed label column (changed later the same day).
// The variant sheet's finding was that a LABEL is what makes a row read as data - identical borders
// alone did not, and rules without labels still read as paragraphs. That finding is intact; what it
// did not establish, and what was wrongly assumed from it, is that the label had to sit BESIDE the
// value. It does not. Stacking keeps the label and returns the ~104px track to the value, which is
// the width the RTO number's eyebrow was already borrowing from the same card.
interface OrgCard {
  name: string; legalName?: string; rtoNumber?: string; role: string;
  blurb?: string; scopeNote?: string; deliversIn?: string; logo?: string;
  tgaUrl?: string; verified?: string; url?: string;
  email?: string; phone?: string;
}
interface Props { people: Person[]; org?: OrgCard; }
const { people, org } = Astro.props;

// Credentials arrive as one " · "-joined string, one claim per entry.
const credList = (s: string) => s.split(' · ').map((c) => c.trim()).filter(Boolean);

/* `Label: value` inside a credential becomes a labelled row; anything else spans both columns.
   The 2-24 character bound on the label is what stops a colon deep in a sentence being read as
   one, and the fallback is why an unlabelled record still renders correctly rather than breaking:
   the expert records were written as bare phrases long before this table existed. */
const factOf = (s: string) => {
  const m = s.match(/^([^:]{2,24}):\s*(.+)$/);
  return m ? { label: m[1].trim(), value: m[2].trim() } : { label: null, value: s };
};

/* A fact value holding SEVERAL items becomes a bulleted list; one item stays plain text. Split on
   `;` rather than `·` because `·` is already the separator BETWEEN credentials, so a nested `·`
   would be eaten by credList() one level up. Semicolon is unambiguous here: the values contain
   commas ("CEO, Training Aid Australia") but never semicolons.
   One rule for both card types - "QLD; WA; TAS" and "CEO, X; CEO, Y" are the same shape. */
const parts = (v: string) => v.split(';').map((x) => x.trim()).filter(Boolean);

/* The RTO's facts ARE attributes, so they are authored here rather than parsed. `deliversIn` is a
   real field and not a split of `scopeNote`: two of the three partner records say "... for QLD, WA
   and TAS", but Upskill's says "NSW owner builder and NSW White Card" with no `for` clause at all,
   so any parse would have been correct twice and wrong once. */
const orgFacts = [
  // RTO no is NOT here: it renders as an eyebrow over the figure in the visual column instead.
  { label: 'Accredited by', value: 'Australian Skills Quality Authority (ASQA)' },
  org?.scopeNote ? { label: 'Course', value: org.scopeNote } : null,
  org?.deliversIn ? { label: 'Delivers in', value: org.deliversIn } : null,
].filter((x): x is { label: string; value: string } => x !== null);

/* The bare host, not the full URL: it tells the reader where they are about to land without a line
   of protocol and path, which is the same reasoning ResourceLink gives for printing a host at all.
   Falls back to the raw string rather than throwing on a malformed URL. */
const host = (u: string) => { try { return new URL(u).host.replace(/^www\./, ''); } catch { return u; } };

/* Website sits in the contact table rather than beside the verify link. It is a contact detail, not
   an act of verification, and as a bare host it lines up with the email and phone as one block of
   "how to reach them" instead of trailing the row below as a second-class link. */
const orgContact = [
  org?.email ? { label: 'Email', value: org.email, href: `mailto:${org.email}`, ext: false } : null,
  // E.164, not the displayed string: tel:(07)33316000 is a local number with no country code and
  // many mobile dialers will not complete it. Every partner here is an Australian RTO, so a leading
  // 0 becomes +61; a 1300 or 1800 number has no leading 0 and passes through unchanged.
  org?.phone ? { label: 'Phone', value: org.phone, href: `tel:${org.phone.replace(/\D/g, '').replace(/^0/, '+61')}`, ext: false } : null,
  org?.url ? { label: 'Website', value: host(org.url), href: org.url, ext: true } : null,
].filter((x): x is { label: string; value: string; href: string; ext: boolean } => x !== null);
---
<div class="people">
  {org && (
    <div class="person person-org">
      {/* The partner's own logo stands in for the portrait, in the same r45 frame, so the org card
          lines up with the reviewer's. Raw <img> rather than <Placeholder src=...> for the same
          reason the portraits are: the object-fit and filter rules below are SCOPED, and Astro
          scoped styles do not reach elements a child component renders.

          NO LOGO SHIPS YET. `logo` is optional and no partner record carries one, so every RTO card
          currently renders a labelled placeholder. That is deliberate per PRODUCT.md: an artefact
          that does not exist stays visible as unfinished rather than being papered over. These are
          third-party trademarks and must be the partner's own supplied asset, never scraped. */}
      {/* The number sits UNDER the logo as an eyebrow over the figure, not as a row in the facts
          table. Two reasons: it frees the table of its narrowest, least prose-like row so the label
          column can carry the longer labels without wrapping, and it keeps the logo frame clean -
          the old maroon badge had the number inside it, which is why a real logo could not go there.
          An RTO number is an identifier, and an identifier reads better as a figure with a label
          above it than as a value in a sentence-shaped row. */}
      <div class="org-mark">
        {org.logo
          ? <img class="ph r45 org-logo" src={imageUrl(org.logo)} alt={`${org.name} logo`} loading="lazy" decoding="async" />
          : <Placeholder ratio="r45" label="Logo" desc={org.name} spec="4:5 · supplied by the RTO" />}
        {org.rtoNumber && (
          <p class="org-reg"><span class="org-reg-k">RTO no</span><span class="org-reg-n num">{org.rtoNumber}</span></p>
        )}
      </div>
      <div>
        <h3 class="h3">{org.legalName ?? org.name}</h3>
        {/* Restored 30 Jul 2026. It had been removed as a duplicate of the first credential line
            ("Registered training organisation, RTO 31193"), but the number now lives as a figure in
            the visual column and that run-on line is gone, so the role repeats nothing - and every
            other card in this block leads with a role, so dropping it here was what made the org
            card the odd one out. */}
        <p class="role">{org.role}</p>
        <dl class="fx">
          {orgFacts.map((f) => (
            <div class="fxrow"><dt>{f.label}</dt><dd>{parts(f.value).length > 1
              ? <ul class="vlist" role="list">{parts(f.value).map((x) => <li>{x}</li>)}</ul>
              : f.value}</dd></div>
          ))}
        </dl>
        {/* THE FIRST PARAGRAPH ONLY - what the RTO does. `blurb` holds two logical groups (see the
            comment in the partner records): (1) the RTO's role, (2) ABE Education's role and the
            "does not deliver training, conduct assessment or issue qualifications" line. Group 2 is
            the ASQA disclosure and belongs to the #rto-partner section, which CourseLayout renders
            on every asqa page and which IS disclosure location 6. Printing it again on a card whose
            heading asks "who developed this course" answered a question nobody had reached yet, and
            put the reader through the same denial twice in one section.
            Group 1 stays: it is the answer to that heading, and it describes the partner rather than
            ABE Education.
            This is the same slice the person cards take of `bio` - the card is the summary, the
            dedicated section is the full statement. Removing the paragraph HERE removes no
            disclosure anywhere: location 6 and the per-course footer legal block both keep it
            verbatim, which is asserted by the guardrails and measured in the review. */}
        {org.blurb && org.blurb.split(/\n\n+/).slice(0, 1).map((para) => <p>{para.trim()}</p>)}
        {orgContact.length > 0 && (
          <dl class="fx">
            {orgContact.map((c) => (
              <div class="fxrow"><dt>{c.label}</dt><dd>
                {/* mailto: and tel: are not a change of context and take no cue; the website is
                    external, so it gets the new tab and the announced cue DESIGN.md section 7
                    requires. */}
                {c.ext
                  ? <a class="pl" href={c.href} rel="noopener" target="_blank">{c.value}<span class="sr-only">, opens in a new tab</span></a>
                  : <a class="pl" href={c.href}>{c.value}</a>}
              </dd></div>
            ))}
          </dl>
        )}
        {/* One action, not two. The website moved into the contact table above, which leaves the
            register check standing alone as the thing this card actually invites you to do - and it
            is the invitation the whole card exists to support. Stacked (see the .p-links rule below)
            so the person cards, which do carry two, do not read as one line with a footnote. */}
        <p class="p-links">
          {org.tgaUrl && <a class="pl" href={org.tgaUrl} rel="noopener" target="_blank">Verify on training.gov.au →<span class="sr-only">, opens in a new tab</span></a>}
        </p>
        {org.verified && <p class="org-verified">{org.verified}</p>}
      </div>
    </div>
  )}
  {people.map((p) => (
    <div class="person">
      {/* loading="lazy" because this block sits near the foot of a course page, far below the fold.
          Without it the two portraits were eager, and on a rate-limited r2.dev origin they were
          among the slowest requests on the page while contributing nothing to first paint. Aspect
          ratio is locked by .ph.r45 in global.css, so lazy-loading them costs no layout shift. */}
      {p.portrait
        ? <img class="ph r45" src={imageUrl(p.portrait.src)} alt={p.portrait.alt} loading="lazy" decoding="async" />
        : <Placeholder ratio="r45" label="Portrait" desc={p.name} spec="4:5 · grayscale · FPO" />}
      <div>
        <h3 class="h3">{p.name}</h3>
        <p class="role">{p.role}</p>
        <dl class="fx">
          {credList(p.creds).map((c) => { const f = factOf(c); const ps = parts(f.value);
            const val = ps.length > 1
              ? <ul class="vlist" role="list">{ps.map((x) => <li set:html={x} />)}</ul>
              : <Fragment set:html={f.value} />;
            return f.label
              ? <div class="fxrow"><dt>{f.label}</dt><dd>{val}</dd></div>
              : <div class="fxrow"><dd>{val}</dd></div>;
          })}
        </dl>
        {/* When there is a full profile to link to, this card is the SUMMARY of it, so it
            shows the opening paragraph and sends the reader on. Printing three paragraphs
            here and three more on the profile page makes the card long without making it
            more convincing, and buries the credential list that does the actual work. With
            no profile to link to, nothing else carries the bio, so all of it stays. */}
        {(p.profileHref ? p.bio.slice(0, 1) : p.bio).map((para) => <p set:html={para} />)}
        {/* LinkedIn is a labelled row, not a link beside the profile link, so a person card carries
            the same three blocks as the RTO card: facts, then a contact table, then ONE action. It
            was previously the second of two links in a row, where it read as a footnote of "Full
            profile" rather than as its own thing. External, so it keeps the new tab and the cue. */}
        {p.linkedin && (
          <dl class="fx">
            <div class="fxrow"><dt>Social profile</dt><dd>
              <a class="pl" href={p.linkedin} rel="noopener" target="_blank">LinkedIn<span class="sr-only">, opens in a new tab</span></a>
            </dd></div>
          </dl>
        )}
        {/* ABE Education's own profile is the primary action: it is on this site, it carries the dated
            verification line, and it is the page the E-E-A-T story actually lives on.
            LinkedIn is corroboration, so it drops to secondary. */}
        <p class="p-links">
          {p.profileHref && <a class="pl" href={p.profileHref}>Full profile →</a>}
        </p>
      </div>
    </div>
  ))}
</div>
<style>
  /* Real portraits: crop to the frame and render grayscale to match the design register.
     For colour headshots instead, delete the `filter` line. */
  .person img.ph { object-fit: cover; filter: grayscale(100%); transition: filter .35s ease; }
  .person img.ph:hover { filter: grayscale(0); }
  /* A logo is not a photograph: contain rather than cover so it is never cropped, no grayscale so
     the partner's mark is not altered, and a paper ground with padding so a transparent PNG does
     not sit on the frame's placeholder wash. Overrides the two rules above, which would otherwise
     crop and desaturate it. */
  .person img.org-logo { object-fit: contain; filter: none; background: var(--paper, #fff); padding: 14px; }
  .person img.org-logo:hover { filter: none; }

  /* The visual column is now a stack: mark, then the RTO number beneath it. `.person`'s grid places
     this whole div in the first column, so the logo keeps the full column width instead of sharing
     it with the number.

     `minmax(0, 1fr)`, NOT the default implicit track. A grid track sized `auto` takes the LARGER of
     the container width and its content's min-content width, and `Placeholder`'s caption has a
     min-content of ~197px. So the frame rendered 197px inside a 140px column and overflowed 57px
     into the text column, dragging the RTO number out with it - measured on /styleguide before the
     fix. `minmax(0, ...)` lets the track shrink to the column, which is the same min-width:auto trap
     `.pl-frow dd` documents in global.css, hit here on a track instead of a cell. */
  .org-mark { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-sm); }
  .org-reg { margin: 0; display: grid; gap: 1px; padding-top: var(--s-sm); border-top: 1px solid var(--rule); }
  .org-reg-k { font: 500 10.5px/1.2 var(--font-mono, monospace); letter-spacing: .14em; text-transform: uppercase; color: var(--slate); }
  /* Display face, not mono: this is a figure to be recognised at a glance, and it is the one number
     on the card a reader might repeat back to a regulator. The .num class carries the project's
     tabular-figure setting. */
  .org-reg-n { font: 600 21px/1.1 var(--font-display, sans-serif); color: var(--ink); letter-spacing: .01em; }

  /* The facts table, in step with PartnerDisclosure's .pl-frow (global.css) - same metrics, same
     eyebrow. One hairline per row is what makes it a table; the label above each value is what makes
     the row read as data rather than prose. `first-of-type` rather than `first-child` because the
     <dl> holds .fxrow divs, and a dt/dd pair inside each row means :first-child would not match what
     the eye calls the first row.

     `.fxrow dt` is deliberately the same declaration as `.org-reg-k` above. That is the whole point
     of the change: the RTO number's eyebrow and every fact label are now one treatment, so a reader
     meets a single kind of label on the card instead of two that differ by 0.5px and .04em.

     No `.wide` variant any more. An unlabelled credential used to need one to span the label column;
     with nothing beside the value there is no column to span, so the record just renders its value. */
  .fx { margin: 0 0 var(--s-md); }
  .fxrow { display: grid; gap: 3px; padding: 9px 0; border-bottom: 1px solid var(--rule); }
  .fxrow:first-of-type { border-top: 1px solid var(--rule); }
  .fxrow dt { margin: 0; font: 500 10.5px/1.2 var(--font-mono, monospace); letter-spacing: .14em; text-transform: uppercase; color: var(--slate); }
  .fxrow dd { margin: 0; min-width: 0; overflow-wrap: anywhere; font-size: 15px; font-weight: 500; color: var(--ink-2); line-height: 1.45; }

  /* .vlist (multi-item fact values) is defined in global.css, not here: BundleOffer renders it too,
     and one definition for two users beats two that drift. */

  /* Stacked links. Overrides global.css's baseline row for .person .p-links; the scoped attribute
     selector is what wins the specificity. */
  .person .p-links { flex-direction: column; align-items: flex-start; gap: 6px; }

  /* The dated check is an annotation on the card, not part of its structure, so it takes the same
     dashed rule the .verified ledger uses (global.css: solid is structure, dashed is the edge of a
     note). Mono and small so it reads as furniture rather than as another fact. */
  .org-verified {
    margin: var(--s-md) 0 0; padding-top: var(--s-sm);
    border-top: 1px dashed var(--rule-strong);
    font: 500 11px/1.4 var(--font-mono, monospace); letter-spacing: .08em;
    text-transform: uppercase; color: var(--slate);
  }
</style>
