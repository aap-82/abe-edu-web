---
import Placeholder from './Placeholder.astro';
import { imageUrl } from '../lib/images';
import type { Person } from '../types/course';
import { leadClause } from '../lib/lead-clause';
// Two-profile E-E-A-T block: developer + reviewer. Grayscale portraits; if a portrait is missing,
// keep the FPO placeholder and do NOT add `image` to Person schema.
//
// `org` fills the DEVELOPER slot with an organisation instead of a person. On an asqa-accredited
// page the course is developed and owned by the RTO partner (not any ABE Education person, see
// kb/rules/authority-model.md §6), so the developer card is the RTO: a monogram badge carrying its
// number instead of a portrait, its role and scope as the credential list, and a training.gov.au
// verify link instead of a LinkedIn/bio. It renders FIRST, so the pairing reads developer → reviewer
// exactly as the two-person version did.
interface OrgCard {
  name: string; legalName?: string; rtoNumber?: string; role: string;
  blurb?: string; scopeNote?: string; tgaUrl?: string; verified?: string; url?: string;
  email?: string; phone?: string;
}
interface Props { people: Person[]; org?: OrgCard; }
const { people, org } = Astro.props;
// Credentials arrive as one " · "-joined string. They used to render as that same run-on
// line with the separators recoloured, which put four distinct claims into a single
// paragraph sitting directly above three paragraphs of bio, at similar weight. The
// credentials are the load-bearing content on a trust block, and they dissolved into the
// prose. Split into real list items instead: scannable, and structurally distinct from the
// bio below it.
const credList = (s: string) => s.split(' · ').map((c) => c.trim()).filter(Boolean);

// Credential lines keep their original slate colour; only the LEADING KEYWORD is highlighted, so
// the line reads as one phrase with an emphasis rather than as two competing tones. The split rule
// and the reasoning behind it now live in src/lib/lead-clause.ts, shared with CanCant.
const orgCreds: string[] = [
  org?.rtoNumber ? `Registered training organisation, RTO ${org.rtoNumber}` : null,
  'Accredited by the Australian Skills Quality Authority (ASQA)',
  org?.scopeNote ?? null,
].filter((x): x is string => x !== null);
---
<div class="people">
  {org && (
    <div class="person person-org">
      <div class="org-badge ph r45" aria-hidden="true">
        <span class="rb-k">RTO</span>
        <span class="rb-n num">{org.rtoNumber}</span>
      </div>
      <div>
        <h3 class="h3">{org.legalName ?? org.name}</h3>
        {/* No standalone `role` line on the ORG card: `org.role` is "Registered training
            organisation", and the first credential below is "Registered training organisation,
            RTO 31193" - the same words plus the number, immediately underneath. The blurb used to
            sit between them and hide it; removing the blurb put them adjacent and the repetition
            became the first thing the card said twice. The person cards keep their `role` line,
            which is not duplicated anywhere. */}
        <ul class="cred-list" role="list">
          {orgCreds.map((c) => { const [k, rest] = leadClause(c); return (
            <li>{k && <span class="cl-k" set:html={k} />}<span set:html={rest} /></li>
          ); })}
        </ul>
        {/* THE BLURB IS NOT RENDERED HERE. `PartnerDisclosure` owns it, and this card owns the
            credential facts above: RTO number, ASQA accreditation, unit scope, verification link.
            Both components read the same partner record, so rendering `blurb` in both put the two
            role-separation paragraphs on every ASQA page VERBATIM TWICE - filed four times across
            four reviews before it was decided, because each filing stopped at "one of them should
            not" without saying which.

            Why this one loses: the blurb IS the disclosure. It states who develops, delivers and
            assesses, and that ABE Education is not an RTO - which is disclosure location 6 in
            kb/rules/asqa-disclosure-framework.md, "a dedicated section (or equivalent role cards)
            must clearly separate ABE Education's role from the RTO's role". `PartnerDisclosure` is
            that dedicated section, it is placed for compliance (after-hero or after-body, always
            exactly one of the two whenever `asqa` exists), and it renders first. Location 6 wants
            the separation once, not twice.

            Removing it is safe rather than lucky: this card only receives an `org` via
            `ExpertCredentials developerRto`, which is set only on pages that also have `asqa`, so
            the disclosure is never dropped. Verified by counting the rendered strings across every
            built page before and after - white-card-tas and white-card-wa went 2 -> 1, and
            accreditation, which never renders this component, stayed at 1. */}
        {/* NO CONTACT DETAILS HERE. `PartnerDisclosure` owns them, for the same reason it owns the
            blurb: it is the disclosure block, it is placed after the hero for compliance, and "who
            delivers this and how you reach them" is one thought that should not be split across two
            screens. It also presents them better — a labelled <dl> with Email and Phone terms,
            against the bare pair of links this card used to render.

            Both components read the same partner record, so both rendered the same address and the
            same number on every ASQA page. Filed twice; this is the third duplication removed from
            this card, after the blurb and the redundant role line.

            What this card keeps is what it alone can say: the RTO badge, the credential list, the
            verification link and the checked date. Credentials are what an organisation HOLDS;
            contacting it is an action, and the action belongs with the disclosure. */}
        <p class="p-links">
          {/* Both open in a new tab, and BOTH must: they are peers in one baseline row, so
              splitting the behaviour between two identical-looking links is worse than the
              inconsistency it would fix. The .sr-only cue announces the tab change (WCAG 3.2.5). */}
          {org.tgaUrl && <a class="pl" href={org.tgaUrl} rel="noopener" target="_blank">Verify on training.gov.au →<span class="sr-only">, opens in a new tab</span></a>}
          {org.url && <a class="pl pl-2" href={org.url} rel="noopener" target="_blank">Website<span class="sr-only">, opens in a new tab</span></a>}
        </p>
        {org.verified && <p class="org-verified">{org.verified}</p>}
      </div>
    </div>
  )}
  {people.map((p) => (
    <div class="person">
      {/* Raw <img> rather than <Placeholder src=...>, deliberately, even though Placeholder
          would carry these attributes for free: the grayscale rule below is a SCOPED style,
          and Astro scoped styles do not reach elements rendered by a child component. Route
          this through Placeholder and the portraits silently render in full colour. The FPO
          branch has no such rule, so it can stay a Placeholder.

          loading="lazy" because this block sits near the foot of a course page, far below
          the fold. Without it the two portraits were eager, and on a rate-limited r2.dev
          origin they were among the slowest requests on the page while contributing nothing
          to first paint. Aspect ratio is locked by .ph.r45 in global.css, so lazy-loading
          them costs no layout shift. */}
      {p.portrait
        ? <img class="ph r45" src={imageUrl(p.portrait.src)} alt={p.portrait.alt} loading="lazy" decoding="async" />
        : <Placeholder ratio="r45" label="Portrait" desc={p.name} spec="4:5 · grayscale · FPO" />}
      <div>
        <h3 class="h3">{p.name}</h3>
        <p class="role">{p.role}</p>
        <ul class="cred-list" role="list">
          {credList(p.creds).map((c) => { const [k, rest] = leadClause(c); return (
            <li>{k && <span class="cl-k" set:html={k} />}<span set:html={rest} /></li>
          ); })}
        </ul>
        {/* When there is a full profile to link to, this card is the SUMMARY of it, so it
            shows the opening paragraph and sends the reader on. Printing three paragraphs
            here and three more on the profile page makes the card long without making it
            more convincing, and buries the credential list that does the actual work. With
            no profile to link to, nothing else carries the bio, so all of it stays. */}
        {(p.profileHref ? p.bio.slice(0, 1) : p.bio).map((para) => <p set:html={para} />)}
        {/* ABE Education's own profile is the primary action: it is on this site, it carries the dated
            verification line, and it is the page the E-E-A-T story actually lives on.
            LinkedIn is corroboration, so it drops to secondary. */}
        <p class="p-links">
          {p.profileHref && <a class="pl" href={p.profileHref}>Full profile →</a>}
          {/* Full profile is INTERNAL and stays in-tab; LinkedIn is corroboration off-site, so it
              opens in a new tab with the .sr-only cue. The split is deliberate here, unlike the row
              above: the two links differ in destination, not just in label. */}
          <a class="pl pl-2" href={p.linkedin} rel="noopener" target="_blank">LinkedIn<span class="sr-only">, opens in a new tab</span></a>
        </p>
      </div>
    </div>
  ))}
</div>
<style>
  /* Real portraits: crop to the frame and render grayscale to match the design register.
     For colour headshots instead, delete the `filter` line. */
  .person img.ph { object-fit: cover; filter: grayscale(100%); transition: filter .35s ease; }
  .person img.ph:hover { filter: grayscale(0); }
  /* RTO developer card: a monogram badge stands in for the portrait, in the same r45 frame so
     the org card lines up with the reviewer's person card. Uses the maroon accent, not a photo. */
  .org-badge {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .25rem; background: var(--maroon, #800000); color: #fff; text-align: center;
  }
  .org-badge .rb-k { font: 600 .7rem/1 var(--font-mono, monospace); letter-spacing: .18em; opacity: .85; }
  .org-badge .rb-n { font: 700 1.6rem/1 var(--font-mono, monospace); }
  .org-verified { font-size: .8rem; color: var(--ink-3, #666); margin-top: .35rem; }
  /* The line keeps the cred-list's own slate colour; only the leading keyword lifts to ink and 600.
     One emphasis per line, no second tone, no divider. */
  .cred-list .cl-k { color: var(--ink, #1a1a1a); font-weight: 600; }
</style>
