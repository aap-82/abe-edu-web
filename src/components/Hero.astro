---
import Placeholder from './Placeholder.astro';
import ProcessTrack from './ProcessTrack.astro';
import type { CTA } from '../types/course';
interface Proof { n: string; text: string; }
interface Props {
  eyebrow: string;
  h1Html: string;          // may include <span class="dot">.</span>
  updated: string;
  subhead: string;
  ticks: string[];         // 3-4
  cta: CTA;                // href, label, microcopy
  audience?: string;       // who the product is for. Optional: only the CPD bundle sets it.
  proof: Proof[];          // <=3, text only
  howItWorks: string;      // flow text after "How it works:"
  artefactDesc: string;
  artefactSpec?: string;
  artefactImg?: string;   // real image URL; omit to keep the FPO placeholder
  artefactAlt?: string;
  artefactRatio?: 'r54' | 'r45';   // 5:4 landscape (default) or 4:5 portrait, per the image
}
const { eyebrow, h1Html, updated, subhead, ticks, cta, audience, proof, howItWorks, artefactDesc, artefactSpec, artefactImg, artefactAlt, artefactRatio = 'r54' } = Astro.props;

// Ticks carry inline markup: the lead phrase is bolded, the qualifier follows a comma.
// Emitted via set:html so <b> renders rather than printing as text.
const ticksHtml = ticks.map((t) => `<li>${t}</li>`).join('');

// The eyebrow's middot separator becomes a tinted bullet. split/join rather than a
// regex so the character is matched literally, and the span is hoisted into its own
// const so no template literal nests inside another's interpolation.
const dotSep = '<span class="e-dot">•</span>';
const eyebrowHtml = eyebrow.split(' · ').join(' ' + dotSep + ' ');

// A short reassurance line sits directly under the money CTA. Data-driven when the
// page supplies cta.microcopy, with a sensible default so the slot is never empty.
const ctaNote = cta.microcopy ?? 'Pay by card or 4 interest-free payments with Afterpay';
---
<section class="hero" id="top">
  <div class="wrap">
    <div>
      <div class="hero-top">
        <span class="eyebrow" set:html={eyebrowHtml}></span>
        <span class="updated">{updated}</span>
      </div>
      <h1 class="h1" set:html={h1Html} />
      <p class="lede">{subhead}</p>
      <ul class="hero-ticks" set:html={ticksHtml}></ul>
      {/* Qualification sits immediately before the ask, so the reader answers "is this me?"
          before they answer "do I buy?". "Built for" states relevance, deliberately NOT
          "Counts for": the bundle's twelve courses do not all carry every building licence
          (see kb/register/cpd — a builder gets 12 points, other licences 10 or 11), so a
          points claim across all seven would be false. */}
      {audience && <p class="hero-audience"><b>Built for</b> {audience}</p>}
      <div class="hero-cta">
        <a class="btn-primary" href={cta.href} id="enrol">{cta.label}</a>
      </div>
      <p class="cta-note">{ctaNote}</p>
      {/* Dividers are drawn by CSS between stats, so a wrap can never strand one. */}
      <div class="proof">
        {proof.map((p) => (
          <span class="stat"><span class="n num">{p.n}</span><span class="l">{p.text}</span></span>
        ))}
      </div>
    </div>
    <div class="z-img">
      <Placeholder ratio={artefactRatio} desc={artefactDesc} spec={artefactSpec} src={artefactImg} alt={artefactAlt} eager={!!artefactImg} />
    </div>
    {/* ProcessTrack sits UNDER THE HERO IMAGE, in the right column. 12 Aug 2026, Andrey's call
        across three passes: it was the hero's full-width last row, was briefly moved out of the
        section entirely, and neither was right. The target is the dead space beneath the image —
        on a typical course page the text column runs ~140px taller than the image, and that gap was
        the only unresolved area of the hero.

        The placement is done in global.css, not here: the text column spans both grid rows while
        the image and this share column 2, so the process lands directly under the image rather than
        below the whole hero. Markup order stays text -> image -> process, which is also the reading
        order.

        This does NOT reintroduce the failure the old comment guarded against. That was the process
        living in the TEXT column, where it made the column taller than the image and, on the bundle
        where the image cover-fills, the image overran and clipped the last step. It is now in the
        image's own column, below it, so it cannot lengthen the text column and the image cannot
        overrun it. Verified on /cpd-building-tas specifically. */}
    <ProcessTrack steps={howItWorks} />
  </div>
</section>
