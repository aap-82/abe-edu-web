---
import type { ModuleGroup } from '../types/course';
/**
 * The syllabus, as a disclosure list. One group per row; the first opens on load, the rest open on
 * click.
 *
 * DESIGN.md section 7 prescribes "Reference / syllabus | Dense, mono-numbered rows, scanned not
 * read". It assigned TopicGrid to the job, but TopicGrid renders a three-column card grid, so the
 * output contradicted the rule it was meant to satisfy. Cards were wrong for a second reason: the
 * reader's-job table gives cards to "browse between entry points", and a module group is not an
 * entry point, there is nowhere to click. That argument still stands and this is still rows.
 *
 * WHAT CHANGED, AND THE RULE IT BREAKS (31 Jul 2026, Andrey's call after reviewing six rendered
 * variants). The rows now collapse. PRODUCT.md's Accessibility and Inclusion section says
 * "Decision-critical content (eligibility, cost, requirements, what the course actually is) stays
 * fully visible and is never hidden behind an accordion. Accordions are for FAQs only", and
 * DESIGN.md section 7 says the same twice: in the reader's-job table ("An accordion (FAQ only)",
 * avoid "Hiding eligibility, cost, or requirements") and in the rules under it. The syllabus IS
 * what the course actually is, and this section's H2 asks "What do the modules cover?".
 *
 * So this component now contradicts two canonical documents. That is recorded rather than
 * smoothed over: the alternative was five rendered variants that kept the rule, one of which
 * (variant A, every group open) was measured and offered. The exception is Andrey's to make and he
 * made it with the trade-off in front of him. `skill-reviews/design/2026-07-31-module-accordion.md`
 * carries the measurements, and a [skills] demand item asks for PRODUCT.md and DESIGN.md to be
 * reconciled with this, because a rule that the code silently ignores is worse than either the rule
 * or the code being wrong on its own.
 *
 * Native <details>/<summary>, no JS: the same mechanism `Faq.astro` uses, so the site has one
 * accordion rather than two, and collapsed content stays in the DOM and in `dist/` where a crawler
 * still reads it.
 *
 * THREE DATA SHAPES, because the five states author this differently and only QLD has all of it:
 *   contents + outcome  ->  two columns, Modules beside You will be able to      (QLD)
 *   body only           ->  the prose, one column, no eyebrows       (ACT, TAS, WA, NSW)
 *   body + either       ->  the prose above the columns, as the note it is meant to be
 * A group with `body` alone puts one sentence behind a click, which is a thin reward for the
 * gesture. It is what the data supports today; the fix is authoring `contents` and `outcome` for
 * those four states, which is build-session work and is on the demand list.
 */
interface Props { items: ModuleGroup[]; }
const { items } = Astro.props;

/**
 * The summary count, split into figure and word so the two can be coloured apart: the digit carries
 * the information, the noun only labels it. Empty for a group with neither list, which is why it is
 * rendered conditionally rather than as a joined string.
 */
const countParts = (m: ModuleGroup) => {
  const mods = m.contents?.length ?? 0;
  const outs = m.outcome?.length ?? 0;
  const parts: { n: number; word: string }[] = [];
  if (mods) parts.push({ n: mods, word: mods === 1 ? 'module' : 'modules' });
  if (outs) parts.push({ n: outs, word: outs === 1 ? 'outcome' : 'outcomes' });
  return parts;
};
const hasColumns = (m: ModuleGroup) => Boolean(m.contents?.length || m.outcome?.length);
---
<ol class="mrows" role="list">
  {items.map((m, i) => (
    <li class="mrow">
      <details open={i === 0}>
        <summary>
          <span class="mr-key">
            <span class="mr-no num">{m.tag}</span>
            {m.modules && <span class="mr-range num">{m.modules}</span>}
          </span>
          <h3 class="mr-title" set:html={m.title} />
          {countParts(m).length > 0 && (
            <span class="mr-count num">
              {countParts(m).map((p, n) => (
                <span class="mr-count-part">{n > 0 ? ' · ' : ''}<span class="mr-count-n">{p.n}</span> {p.word}</span>
              ))}
            </span>
          )}
          <span class="mr-mark" aria-hidden="true">+</span>
        </summary>

        <div class="mr-panel">
          {m.body && <p class="mr-body" set:html={m.body} />}

          {hasColumns(m) && (
            <div class="mr-cols">
              <div class="mr-col">
                <span class="mr-clabel">Modules</span>
                <ul class="mr-mods-list" role="list">
                  {m.contents?.map((c) => (
                    <li><span class="mr-mnum num">{c.n}</span><span set:html={c.name} /></li>
                  ))}
                </ul>
              </div>
              <div class="mr-col mr-col-out">
                <span class="mr-clabel">Learning outcomes</span>
                <ul class="mr-olist" role="list">
                  {m.outcome?.map((o) => <li set:html={o} />)}
                </ul>
              </div>
            </div>
          )}
        </div>
      </details>
    </li>
  ))}
</ol>

<style>
  /* ONE CARD, HAIRLINE-SEPARATED INSIDE IT — `.faq`'s container, declaration for declaration
     (1px --rule, radius 8, --paper fill, overflow hidden, --s-lg top margin), with `.mrow + .mrow`
     standing in for `.faq details+details`. 1 Aug 2026, Andrey's call: the site should not have two
     accordions that look like two components.
     This replaces bare rules on the section ground. The objection that stood here — "no card
     borders, because a border per group implies six separable objects when this is one list" — was
     answered, not overruled: it argues against a border PER GROUP, and this is one border around
     the whole list, which is the same shape the FAQ has and reads as one object.
     The fill is what makes the rest of this work. The FAQ's hover is --paper-alt, a step DARKER
     than its --paper rest; without a container the rows inherit whatever ground the section gives
     them, and `#learn` is `bg-alt` (--paper-alt) on five of the six pages that render this, so the
     FAQ's own hover token would have been literally invisible on all five. On --paper it is the
     same step off white that it is in the FAQ, on every page.
     The rules between rows stay SOLID because they are structure, between groups. The one dotted
     line further down divides two columns within a single group, which is the job global.css
     assigns dotted: "solid is structure, dashed is the edge of a note, dotted separates within one". */
  .mrows{
    list-style:none; margin:var(--s-lg) 0 0; padding:0;
    border:1px solid var(--rule); border-radius:8px; background:var(--paper); overflow:hidden;
  }
  .mrow + .mrow{ border-top:1px solid var(--rule); }

  /* HOVER IS BACK ON THE SURFACE, and it is `.faq summary:hover` exactly: --paper-alt, with the
     FAQ's own `transition:background .15s`. This reverses bbc54a0 and 7236dec, which moved hover
     off the surface onto the title, and it is worth being precise about why those are reversed
     rather than simply overridden — their measurements were correct, their premise was not.

     Both were measured with the rows sitting on the SECTION GROUND and with --paper spent on the
     open state. Under that premise the surface really was boxed in: lighter read as a weak version
     of open, and darker ran out at --paper-warm, one step above the #f2eee4 that drops --slate to
     4.40:1. The container above changes the premise. Rest is --paper now, so --paper-alt is a step
     DOWN off white rather than a fourth value squeezed between the ramp and the open state, and it
     is the same step the FAQ has been making since it shipped.

     Open therefore takes NO tint, which is the other half of parity: `.faq details[open]` sets no
     background either. Open is carried by the plus rotating to a cross and by the panel appearing —
     two unambiguous signals — so spending a third on it was what pushed hover into the corner the
     two previous commits were trying to get out of. The background now means one thing, hover, and
     the marker means the other.

     MEASURED with getComputedStyle in the browser, --slate (#6e6e6e, which carries the count, the
     range and the marker) against the resolved summary background, on both grounds this component
     ships on:
       rest / open   #ffffff   --slate 5.10:1
       hover         #f7f4ec   --slate 4.64:1
     Identical on the WA page (--ground section) and on the qld/act/tas/nsw pages (bg-alt section),
     because the card fill no longer lets the section ground reach the row. 4.64 clears the 4.50 AA
     floor with room, where the darker direction the old comment was pushed towards did not. */
  .mrow summary{ transition:background .15s; }
  .mrow summary:hover{ background:var(--paper-alt); }

  /* OPEN NOW CARRIES THE SAME TINT AS HOVER. Andrey's call, 12 Aug 2026: "when hover over use light
     grey background for the title row. when open keep it light grey and body white."

     This reverses the "Open therefore takes NO tint" paragraph above, and the reversal is his to
     make, but the paragraph's reasoning is NOT what is being overturned and should not be read as
     discredited. Its worry was that spending a tint on open squeezed hover into a corner, because
     back then open was spending --paper and hover had to find a fourth value between the ramp and
     the open state. That is no longer the shape: open and hover now share ONE value, so nothing is
     squeezed and no new token is introduced.

     What the reversal does cost, stated plainly rather than discovered later: hovering an ALREADY
     OPEN row produces no background change, because the two states resolve to the same colour. The
     affordance survives where it matters — every closed row still lights on hover — and an open row
     already announces itself twice, by the cross and by the visible panel. That is the trade.

     `> summary` is scoped to the direct child so a nested <details> could never inherit it, and the
     panel is untouched, so the body stays --paper white as asked.

     MEASURED with getComputedStyle after the change, --slate (#6e6e6e, which carries the count, the
     range and the marker) against the resolved background:
       closed rest    #ffffff   5.10:1
       hover          #f7f4ec   4.64:1
       OPEN summary   #f7f4ec   4.64:1   <- new, clears the 4.50 AA floor
       open panel     #ffffff   5.10:1   <- unchanged, body stays white
     Note --paper-alt is a WARM off-white in this palette, not a neutral grey. A true grey would be
     a new token and therefore a design-register change under rule 7, which this is not. */
  .mrow details[open] > summary{ background:var(--paper-alt); }
  /* Reduced motion drops the fade and keeps the colour: the state still reads, it just arrives at
     once. A background cross-fade is not vestibular motion, but it is the same interaction as the
     marker rotation below and they should not disagree. */
  @media (prefers-reduced-motion:reduce){
    .mrow summary{ transition:none; }
  }

  /* The rail track is 150px MINUS the column gap, so that once the gap is added back the title
     starts at exactly 150px: the same x as the panel below it. That gives the title, the Modules
     eyebrow and the module numbers one shared left edge, with only the group key outside it in its
     rail. A bare 150px track left every panel sitting 24px left of its own title. */
  .mrow summary{
    display:grid; grid-template-columns:calc(150px - var(--s-md)) 1fr auto 20px;
    align-items:baseline; gap:var(--s-md);
    min-height:44px; cursor:pointer; list-style:none;
    /* 20px 24px, `.faq summary`'s padding exactly, replacing 24px 16px. The horizontal room is
       INSIDE the row, not outside it: an early attempt pulled the tint 16px wider than the row,
       which put it past the hairline closing every row, and now past the card border as well. The
       background spans the full row width and stops exactly on the rules; the text sits 24px in
       from its edges. Top and bottom match each other, open or closed, so the heading is not
       lighter under the title than above it.
       24px is now the component's gutter and `.mr-panel` carries the same value, so the card has
       one inset rather than two. */
    padding:20px 24px;
  }
  .mrow summary::-webkit-details-marker{ display:none; }
  /* The ring goes on the summary, which is the focusable element; inset so the row rule above does
     not clip it. */
  .mrow summary:focus-visible{ outline:2px solid var(--ink); outline-offset:-3px; }
  /* The open summary used to drop its bottom padding to --s-sm, so an open heading sat 24px clear of
     the row above and only 16px clear of its own content. Symmetric now: --s-md both sides, open or
     closed, and the panel adds nothing on top, so the space above the Modules eyebrow and the space
     below the last outcome are the same 24px and the open block is balanced. */

  /* TYPE, reconciled to DESIGN.md section 3 on 31 Jul 2026. The component had grown five mono
     elements across three sizes (12/11/10), two weights (500/400) and three trackings
     (.14/.12/.04em), which is not a scale, it is an accumulation. Canon is one Label style: DM Mono
     500, 11px, .18em, uppercase, and the Mono Label Rule allows .08em to .18em with "the wider the
     tracking, the smaller the type".
     Three of those were straight breaches rather than judgement calls: `.mr-count`, `.mr-range` and
     `.mr-mnum` sat at **.04em, below the .08em floor**, at weight 400 where every mono label on the
     site is 500, and the count rendered **lowercase** where the rule says mono is always uppercase.
     Now: 11px/500 throughout, with tracking carrying the hierarchy instead of size. .18em on the
     group key (canon Label exactly) and on the 10px column eyebrows, per "wider tracking, smaller
     type"; .1em on the supporting run of count, range and module number, which sit inside the .08 to
     .18em band and read quieter without changing size.
     The key rail is fixed so the numbers line up down the page and can be scanned without reading;
     tabular figures via .num keep the ranges from jittering. */
  .mr-key{ display:flex; flex-direction:column; gap:4px; }
  .mr-no{
    font-family:var(--font-mono); font-size:11px; font-weight:500;
    letter-spacing:.18em; text-transform:uppercase; color:var(--maroon);
  }
  .mr-range{
    font-family:var(--font-mono); font-size:11px; font-weight:500;
    letter-spacing:.1em; text-transform:uppercase; color:var(--slate);
  }

  /* 22px, the documented Title step (DESIGN.md section 3: Archivo 600 22px). Andrey's call,
     11 Aug 2026, after this sat as a demand item across three filings.
     It was 18px for a real reason, recorded here so the trade-off is not re-litigated from
     scratch: 18px was the one size in this component that matched no documented step, kept
     because ACT renders TWELVE group titles and the worry was that at 22px the rail would stop
     reading as a scannable index and start reading as twelve headings. That was a hierarchy
     judgement about the whole section rather than a typographic tidy-up, which is why it went to
     a human rather than being decided by a design session.
     Measured before and after on ACT, the worst case, rather than assumed. At 1280px NOTHING WRAPS
     at either size - all twelve titles stay on one line - so the desktop rail keeps its
     one-line-per-row rhythm and the index reading the 18px note was protecting survives; the
     section grows 1856px to 1916px, +3.2%. The cost lands on mobile: at 375px the same 8 of 12
     titles wrap as before, but two move from two lines to three, and the section grows 2651px to
     2811px, +6%. Judged acceptable against register conformance. Against the 15px row body this is
     now a 1.47 step, comfortably past the 1.25 the scale asks for, where 18px sat at 1.2 and under
     it. */
  .mr-title{
    font-family:var(--font-display); font-weight:600; font-size:22px;
    line-height:1.25; letter-spacing:-.01em; color:var(--ink); margin:0;
  }

  .mr-count{
    font-family:var(--font-mono); font-size:11px; font-weight:500;
    letter-spacing:.1em; text-transform:uppercase; color:var(--slate);
    white-space:nowrap;
  }
  /* The separator is a real text node, not a ::before. As generated content it looked identical and
     read "2 modules3 outcomes" to anything using textContent: copy-paste, text extraction, tooling
     that does not resolve CSS. A separator between two facts is content, not decoration. */
  /* Figures maroon, nouns slate. This is one of three maroon-on-a-non-action marks in this file (the
     module numbers and the outcome discs are the others), all Andrey's calls on 31 Jul 2026. At
     three it is no longer a run of exceptions to "Heritage Maroon for actions only" but a second,
     consistent job the colour does here: FIGURES. Settling that belongs in the design register, and
     is on the demand list rather than being decided one override at a time. */
  .mr-count-n{ color:var(--maroon); }

  /* The SAME mark the FAQ uses: a literal maroon "+" that rotates 45 degrees to a cross when open,
     matching `.faq summary .pm` in global.css declaration for declaration (maroon, 20px,
     line-height 1, transform .2s). It was a pair of CSS-drawn slate rules, on the reasoning that
     disclosure is navigation rather than an action and so should not spend maroon. That reasoning
     was wrong twice over: DESIGN.md section 5 documents the house accordion as "a maroon plus-mark
     rotates 45 degrees to a cross when open", so maroon here is the documented behaviour rather than
     an exception to the One Maroon Rule, and the site should not have two accordions that disclose
     with different glyphs in different colours. */
  /* `justify-self:center` and the display face are both load-bearing, and copying the FAQ's
     declarations without them was not the same mark.
     A grid item stretches to its track by default, so this span was 20px wide with a ~12.7px glyph
     sitting at its left. `transform-origin` then resolved to 10px, the centre of the BOX, and the
     plus swung through an arc on its way to a cross instead of spinning where it sat. Content-sized,
     the origin is the centre of the glyph (6.37px), which is what `.faq summary .pm` gets for free
     as a `flex:none` flex item. The 20px track stays so the column reserves the same width whatever
     the glyph measures.
     The face matters for the same reason: `.faq summary` sets `--font-display`, so the FAQ's plus is
     Archivo. This one inherited DM Sans from the page and drew a different glyph at the same size. */
  .mr-mark{
    justify-self:center; align-self:center;
    font-family:var(--font-display); font-weight:600; color:var(--maroon); font-size:20px;
    line-height:1; transition:transform .2s;
  }
  .mrow details[open] .mr-mark{ transform:rotate(45deg); }
  @media (prefers-reduced-motion:reduce){
    .mr-mark{ transition:none; }
  }

  /* `.faq .ans`'s padding — `var(--s-sm) 24px 22px` — with the left value carrying the 150px rail on
     top of the shared 24px gutter, so the panel aligns under the title rather than under the group
     key. Right and bottom are the FAQ's verbatim.
     TOP PADDING IS ITS OWN, and this is the thing that was wrong twice. The summary's bottom padding
     looks like separation until the two elements have different backgrounds, which they do the
     moment a pointer is over the heading: the summary goes --paper-alt while the panel stays
     --paper, so any space borrowed from the summary sits INSIDE the tinted band and the Modules
     eyebrow ends up flush against its lower edge. Padding that belongs to the panel has to live on
     the panel. This is the same reason `.faq .ans` sets a top value at all, and global.css says so
     in as many words: "the summary takes a paper-alt background on hover, and with a 0 top the open
     answer sat flush against that coloured band". Same component, same fix, same number. */
  .mr-panel{ padding:var(--s-sm) 24px 22px calc(150px + 24px); }

  /* 480px, matching `.measure` and the caps global.css settled on. `ch` is not used anywhere in this
     file: it is the advance of the "0" glyph, wider than the average character in DM Sans, so a ch
     cap buys more characters than it names. Measured on the built pages, `70ch` here rendered up to
     102 CPL against the project's 85 hard rule; 480px renders 60 to 72. */
  .mr-body{ font-size:15px; line-height:1.6; color:var(--ink-3); margin:0; max-width:480px; }
  .mr-body + .mr-cols{ margin-top:var(--s-md); }

  /* Asymmetric, and deliberately so. Split 50/50 the modules column measured 408px holding names
     that peak at 40 characters, with most lines just a number, while the outcome sentences were
     squeezed to 41 CPL: half the grid carrying a fifth of the words. 300px fits the longest real
     module name across the six pages and gives the rest to the sentences. */
  .mr-cols{
    display:grid; grid-template-columns:minmax(0,300px) minmax(0,1fr);
    gap:var(--s-xl); align-items:start;
  }
  .mr-col{ max-width:480px; }
  .mr-col-out{ padding-left:var(--s-xl); border-left:1px dotted var(--rule-strong); }
  /* --rule-strong, not --rule: a dotted line inks about half the pixels a solid one does, and at
     --rule it reads as a smudge rather than a division. */
  .mr-clabel{
    display:block; margin-bottom:9px;
    font-family:var(--font-mono); font-size:11px; font-weight:500;
    letter-spacing:.18em; text-transform:uppercase; color:var(--slate);
  }

  /* One module per line, its number in the mono/tabular face so the numbers form a scannable column
     instead of hiding mid-sentence. A group's modules are not always contiguous (QLD group 02 is 3,
     11, 12), which is why the range in the rail is not enough on its own.
     Numbers are LEFT-aligned, so the digits start on the column's own left edge and the list reads
     flush with the eyebrow above it. The rail is a fixed track either way, so the names stay aligned
     regardless. Deeper maroon than --maroon so a column of numbers sits back rather than competing
     with the group title. */
  .mr-mods-list{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:5px; }
  .mr-mods-list li{
    display:grid; grid-template-columns:28px 1fr; gap:var(--s-sm);
    font-size:15px; line-height:1.55; color:var(--ink-3);
  }
  .mr-mnum{
    font-family:var(--font-mono); font-size:11px; font-weight:500; letter-spacing:.1em; color:#600000;
    text-align:left; padding-top:3px; font-variant-numeric:tabular-nums;
  }

  /* Learning outcomes as a bullet list. `outcome` is an array, one discrete statement per <li>.
     Items are authored capitalised and end-stopped in the source, so no ::first-letter fix-up is
     needed.
     15px/1.55, matching the module names exactly. These two lists are PEERS: they sit side by side,
     they hold the same kind of short statement, and they were set 15px/1.5 against 14px/1.55 for no
     reason either of them records. A 15-against-14 step is the muddy hierarchy the typography
     reference names by example: too close to read as deliberate, far enough to look like a mistake.
     Same size, same leading, and the difference between the columns is carried by their eyebrows and
     by ink colour, which is where it belongs. */
  .mr-olist{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:6px; }
  .mr-olist li{
    position:relative; padding-left:18px;
    font-size:15px; line-height:1.55; color:var(--ink-2);
  }
  .mr-olist li::before{ content:"\2022"; position:absolute; left:4px; color:var(--maroon); }

  /* Stack on narrow screens. A 150px rail beside a ~170px text column is not a list any more, it is
     two cramped columns. The summary goes to three explicit rows: sharing one row with the count
     left the title about 200px and broke "Design & energy" over three lines, and the count is the
     least important thing in the row. Rows are placed explicitly because auto-flow cannot backtrack
     into the free column-2 slot beside the title, and dropped the marker onto a fourth row of its
     own where it read as a stray dash. */
  @media (max-width:640px){
    /* Padding is NOT reduced here, because `.faq` does not reduce its own: the FAQ runs 20px 24px
       at every width, and a narrower gutter on this one would put the two accordions back out of
       step at exactly the size most readers see them. 24px inside a 28px `.wrap` still leaves the
       title ~233px at 375px, which is what the FAQ's own summary gets. */
    .mrow summary{ grid-template-columns:1fr 20px; row-gap:3px; }
    .mr-key{ grid-area:1 / 1 / 2 / 3; flex-direction:row; align-items:baseline; gap:10px; }
    .mr-title{ grid-area:2 / 1 / 3 / 2; }
    .mr-mark{ grid-area:2 / 2 / 3 / 3; align-self:center; }
    .mr-count{ grid-area:3 / 1 / 4 / 3; }
    /* The rail collapses at this width, so the panel loses the 150px offset and keeps the shared
       gutter: the FAQ's own `.ans` values, unmodified. */
    .mr-panel{ padding:var(--s-sm) 24px 22px; }
    .mr-cols{ grid-template-columns:1fr; gap:var(--s-md); }
    /* Stacked, the divider turns horizontal but is still the same within-a-group line, so it stays
       dotted. Solid here would be indistinguishable from the rule that ends the group. */
    .mr-col-out{ padding-left:0; padding-top:var(--s-md); border-left:0; border-top:1px dotted var(--rule-strong); }
  }
</style>
