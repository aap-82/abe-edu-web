---
import { getCollection } from 'astro:content';
import type { PartnerInfo } from '../types/course';
// "About the RTO" card for an asqa-accredited page, LANDSCAPE layout. ABE Education publishes the
// course; the named RTO partner DEVELOPS, delivers and assesses it and issues the nationally
// recognised credential. ABE Education is not an RTO. See kb/rules/authority-model.md §6.
//
// Identity + units + credential arrive as props from the page's `partnerRto`; the richer profile
// (legal name, description, contact, training.gov.au link, verified date) is resolved here from the
// matching `partners` record by RTO number. This card is ASQA disclosure locations 2 and 6 combined,
// so nothing factual can be dropped: name, unit, delivered-by/number/credential, contact, the
// "recruits and markets ... not an RTO" disclosure, and the TGA verify link all stay.
//
// GROUPING: an identity header (who + how to verify) across the top; a two-column body (the training
// facts | plain-language description + contact); the formal ASQA disclosure as fine print at the foot.
// CSS class names avoid the substring "rto" on purpose: the authority-language guardrail scans the
// bundled CSS on state-approved pages and matches it as a forbidden claim.
// headingLevel exists because this card's heading level depends on WHERE the layout puts it, which
// the card cannot know. At `after-body` it follows the page's h2 sections and h3 is right. At
// `after-hero` it is the FIRST heading after the h1, and a hardcoded h3 skipped a level (WCAG 1.3.1)
// - measured on /white-card-wa as the page's only heading-order violation. The visual is unchanged
// either way: `class="h3"` carries the look, the tag carries only the semantics.
type Props = PartnerInfo & { headingLevel?: 2 | 3 };
const { partner, rto, units = [], credential = 'Statement of Attainment', headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';

const rec = (await getCollection('partners')).find((p) => p.data.rtoNumber === rto)?.data;
const legal = rec?.legalName ?? partner;
---
<div class="partner partner-land">
  <div class="pl-head">
    <div class="pl-id">
      <Heading class="h3">{legal}</Heading>
      <p class="pl-role">{rec?.role ?? 'Registered training organisation'}</p>
    </div>
    <div class="pl-check">
      <span class="pl-reg"><span class="pl-reg-k">RTO</span><span class="pl-reg-n num">{rto}</span></span>
      {/* New tab, like every external link in this card and in ResourceLink: checking an RTO's
          registration is a verify-then-return errand, and sending the reader off the page mid-decision
          loses them. The .sr-only cue is required, not decorative - an unannounced tab change is a
          WCAG 3.2.5 failure, and it is the only thing that makes the behaviour perceivable to a
          screen-reader user. */}
      {rec?.tgaUrl && <a class="pl-verify" href={rec.tgaUrl} rel="noopener" target="_blank">Verify on training.gov.au →<span class="sr-only">, opens in a new tab</span></a>}
      {/* SCOPED, because an unlabelled date here contradicts the page. This is when the PARTNER
          RECORD was last checked (src/content/partners/*.md), not when the page's government facts
          were verified — those carry their own dates in each VerifiedSources block and the hero
          line. On /white-card-wa the two differ by nine days, and an independent audit read the
          older one as the page's own, on the page's single most important trust artefact. The
          date is not wrong; it was unlabelled. Saying what it covers costs four words. */}
      {rec?.verified && <span class="pl-verified">Provider record · {rec.verified}</span>}
    </div>
  </div>

  <div class="pl-grid">
    <div class="pl-col">
      <span class="pl-lbl">The training</span>
      {units.length > 0 && (
        <ul class="p-units" role="list">
          {units.map((u) => (
            <li class="p-unit">
              <span class="p-code num">{u.code}</span>
              <span class="p-name">{u.name}</span>
            </li>
          ))}
        </ul>
      )}
      <dl class="pl-facts">
        <div class="pl-frow"><dt>Delivered by</dt><dd>{partner}</dd></div>
        <div class="pl-frow"><dt>Credential</dt><dd>{credential}</dd></div>
      </dl>
    </div>

    <div class="pl-col">
      <span class="pl-lbl">About the training provider</span>
      {/* One <p> per logical group. `blurb` stays a single string in the partners schema
          (content.config.ts is skills-owned), so the grouping is carried in the record as
          blank-line-separated paragraphs and split here. A record written as one block still
          renders as one paragraph, so this is backwards-compatible with every existing partner. */}
      {/* \n\n+ not \n{2,}: see Credentials.astro. A brace quantifier inside a JSX expression closes
          it as far as the TypeScript JSX parser is concerned - the Astro compiler builds it fine,
          `npm run check` does not. Identical meaning, no braces. */}
      {rec?.blurb && rec.blurb.split(/\n\n+/).map((para) => <p class="pl-blurb">{para.trim()}</p>)}
      {(rec?.email || rec?.phone) && <span class="pl-lbl">Training provider contact</span>}
      {(rec?.email || rec?.phone) && (
        <dl class="pl-facts">
          {rec?.email && (
            <div class="pl-frow"><dt>Email</dt><dd><a href={`mailto:${rec.email}`}>{rec.email}</a></dd></div>
          )}
          {/* Phone href is E.164, not the displayed string. Stripping whitespace alone left
              tel:(07)33316000 - a local number with no country code, which many mobile dialers will
              not complete. Every partner here is an Australian RTO, so a leading 0 becomes +61; a
              1300 or 1800 number has no leading 0 and passes through unchanged. */}
          {rec?.phone && (
            <div class="pl-frow"><dt>Phone</dt><dd><a href={`tel:${rec.phone.replace(/\D/g, '').replace(/^0/, '+61')}`}>{rec.phone}</a></dd></div>
          )}
        </dl>
      )}
    </div>
  </div>

  <p class="pl-disc">ABE Education recruits and markets this training on behalf of {legal}. {legal} is the
    registered training organisation responsible for developing, delivering and assessing this
    qualification and issuing certification, in accordance with the Standards for Registered Training
    Organisations 2025. ABE Education is not a registered training organisation.</p>
</div>
