---
// FPO image placeholder. Pass `src` (+ `alt` >= 80 chars) to render a real image instead of the FPO.
// `src` goes through responsiveImg(): a file migrated into src/assets/images is served same-origin,
// content-hashed and with a width-based srcset (astro:assets); an un-migrated public path or remote
// URL comes back as a plain src (no srcset), rendering as before. Raw <img>, not <Image>, so the
// scoped .ph-img rule still applies. `sizes` overrides the default when a caller knows its column
// width. See handover/HANDOVER-images-astro-assets.md.
import { responsiveImg } from '../lib/images';
interface Props { ratio?: 'r54' | 'r45'; label?: string; desc: string; spec?: string; src?: string; alt?: string; eager?: boolean; sizes?: string; }
const { ratio = 'r54', label = 'Image placeholder', desc, spec, src, alt, eager = false, sizes } = Astro.props;
const img = await responsiveImg(src, sizes ? { sizes } : {});
---
{ img ? (
  <img class={`ph ${ratio} ph-img`} src={img.src} srcset={img.srcset} sizes={img.srcset ? img.sizes : undefined} width={img.width} height={img.height} alt={alt ?? desc} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
) : (
  <div class={`ph ${ratio}`}>
    <div class="ph-in">
      <span class="ph-l">{label}</span>
      <span class="ph-d">{desc}</span>
      {spec && <span class="ph-s">{spec}</span>}
    </div>
  </div>
) }
<style>
  .ph-img { width:100%; height:100%; object-fit:cover; display:block; background:none; }
</style>
