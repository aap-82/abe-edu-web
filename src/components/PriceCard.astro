---
import type { PriceRow } from '../types/course';
import Footnote from './Footnote.astro';
// `foot` renders through <Footnote>, which owns the fine-print treatment this card used to define
// itself as .price-foot. The prop and every calling page are unchanged; only the markup behind it
// moved, so the six pages passing a `foot` string render identically.
interface Props { rows: PriceRow[]; foot?: string; }
const { rows, foot } = Astro.props;
---
<div class="price-card">
  {rows.map((r) => (
    <div class:list={["price-row", r.isTotal && "total"]}>
      <span class="p-k">{r.label}{r.sub && <small style={r.isTotal ? 'color:rgba(255,255,255,.6)' : undefined}>{r.sub}</small>}</span>
      <span class="p-v num">{r.amount}</span>
    </div>
  ))}
</div>
{foot && <Footnote>{foot}</Footnote>}
