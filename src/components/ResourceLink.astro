---
import ArrowRight from './ArrowRight.astro';
// A pointer to a resource the reader can open: a regulator's record, a register entry, a
// government page, or another page on this site. Sits between prose and a CTA.
//
// WHY THIS EXISTS RATHER THAN A COMPONENT WE ALREADY HAD. Four near-neighbours, none of which
// does this job:
//   VerifiedSources  a dated ledger attesting that WE checked a fact. Passive proof, past tense.
//                    This is the opposite: an invitation for the READER to go and look.
//   Note             a caveat or legal consequence. Inert prose in a box, nothing to open.
//   KeyTakeaway      distils what a section already said. Never new, never a destination.
//   .btn-link        the right loudness, but inline and containerless, so it disappears in a
//                    wall of body copy at exactly the moment a reader wants proof.
// The INTENT had been hand-built twice, as `.pl` in Credentials.astro and `.pl-verify` in
// PartnerDisclosure.astro, both "Verify on training.gov.au →", which is what justified building
// this rather than writing a third one inline.
//
// DO NOT MIGRATE THOSE TWO ONTO THIS COMPONENT. Checked properly on 28 Jul 2026 and the answer
// is no, in both places. What repeated across them is the string and the intent, never the
// SHAPE: both are inline micro-links inside dense cards, and this is a block-level panel sized
// to the prose column.
//   PartnerDisclosure  `.pl-verify` is a 14px link inside `.pl-check`, a right-aligned column
//                      stack under a 24px maroon RTO number. More importantly `.partner` is
//                      itself `--paper` + 1px border + 8px radius, so a bordered panel inside it
//                      is a NESTED CARD, which DESIGN.md bans outright ("cards are never stacked
//                      or nested").
//   Credentials        `.pl` is a 12px mono link in `.p-links`, a baseline-aligned flex row that
//                      pairs it with a peer ("Website", "LinkedIn"). A 544px block would break
//                      the row and orphan its partner.
// Use this component in BODY PROSE, where a reader is mid-argument and needs the evidence. The
// inline treatments stay inline. If those two ever need de-duplicating, the shared thing is a
// small inline verify link, which is a different promotion from this one.
//
// AUTHORITY NOTE. This component links to evidence; it never characterises it. It carries no
// "approved" / "accredited" / "recognised" wording of its own, so it cannot introduce an
// authority-model breach on a page whose model forbids one. Whatever claim is being made stays
// in the prose above it, where the build's authority checks can see it.
//
// NO SLOT, DELIBERATELY. `desc` is a prop, not a <slot>. MDX wraps multi-line JSX children in
// their own <p>, and a <p> nested inside this component's inline markup is invalid, so the
// browser hoists the text out and strands it below an empty panel with a green build. That is
// mistakes-log #12, which cost this pipeline real time once already. A string prop cannot fail
// that way.
interface Props {
  href: string;
  title: string;
  /** DM Mono kicker naming the KIND of source, e.g. "National register", "Regulator".
   *  Optional on purpose: omit it rather than inventing a label, so the panel stays quiet. */
  kicker?: string;
  /** One line on what the reader will find. Keep it to a single sentence. */
  desc?: string;
  /** Overrides the inference below. Only needed for a same-origin URL that is really a
   *  third party, which today means the LearnWorlds paths still served on the apex. */
  external?: boolean;
}
const { href, title, kicker, desc, external } = Astro.props;

// Root-relative is internal; anything with a scheme is external. Our own production origin is
// never written into a visible link (guardrails 7b), so an absolute abeeducation.edu.au URL
// would be a bug elsewhere rather than a case to handle here.
const isExternal = external ?? /^https?:\/\//i.test(href);

// The bare host is the destination tell: it tells the reader where they are about to land,
// which an icon alone cannot. Falls back to nothing rather than throwing on a malformed URL.
let host = '';
if (isExternal) {
  try { host = new URL(href).host.replace(/^www\./, ''); } catch { host = ''; }
}
---
<a
  class="reslink"
  href={href}
  {...isExternal ? { target: '_blank', rel: 'noopener' } : {}}
>
  <span class="rl-main">
    {kicker && <span class="rl-k">{kicker}</span>}
    <span class="rl-t">{title}</span>
    {desc && <span class="rl-d">{desc}</span>}
    {isExternal && host && (
      <span class="rl-host">{host}<span class="sr-only">, opens in a new tab</span></span>
    )}
  </span>
  <ArrowRight />
</a>
