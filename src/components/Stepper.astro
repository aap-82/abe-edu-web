---
import type { Step } from '../types/course';
/**
 * A numbered linear process. Per DESIGN.md section 7: "Follow a process in order | A stepper".
 *
 * `body` takes prose or a list of points. A list renders as bullets with maroon discs, matching the
 * learning outcomes in `ModuleRows`, so the two bulleted things on a course page look like each
 * other. Prose stays a paragraph: a step whose body is one indivisible sentence reads worse as a
 * list of one bullet than as the sentence it is. Which steps carry a list is authored per step, not
 * decided here, for the reason recorded on the schema in `src/content.config.ts`.
 */
interface Props { steps: Step[]; maxWidth?: string; columns?: 1 | 2; }
const { steps, maxWidth, columns = 1 } = Astro.props;
const style = maxWidth ? `max-width:${maxWidth}` : undefined;
---
{/* `columns={2}` is opt-in, per call site, and deliberately not inferred from width.
    A stepper in a ZSection's body column has about 536px; one in the full wrap has 1144px, and
    CSS alone cannot tell those apart without a width rule - which was tried and broke five pages
    at 375px, because `.z-body` is a grid child whose min-content width absorbed the track floor
    and pushed the whole split past the viewport (see `.steps` in global.css). The call site knows
    what container it is in; the stylesheet does not. Two is the ceiling: steps are a sequence,
    and at three the reading order stops being obvious. */}
<div class:list={["steps", columns === 2 && "steps-2"]} style={style}>
  {steps.map((s, i) => (
    <div class="step">
      {/* The numeral moved into its own gutter column (Andrey, 12 Aug 2026, from three rendered
          layouts). It was a single "Step 01" mono line stacked above the title, which put the
          numeral on the same x as everything else and made it read as a caption on the title rather
          than an index. Split into the word and the figure so the figures form a column the eye can
          run down. The word is lowercase on purpose: it is the quiet half of the pair. */}
      <span class="s-k">
        <span class="s-k-w">step</span>
        <span class="s-k-d num">{String(i + 1).padStart(2, '0')}</span>
      </span>
      <div class="s-body">
        <h3 class="h3" set:html={s.title} />
        {Array.isArray(s.body)
          ? (
            <ul class="step-points" role="list">
              {s.body.map((point) => <li set:html={point} />)}
            </ul>
          )
          : <p set:html={s.body} />}
      </div>
    </div>
  ))}
</div>

<style>
  /* Two columns only above 1100px, and only when the call site asked. The breakpoint is above the
     point a ZSection stops splitting, so this can never apply inside a half-width body column even
     if someone opts in there by mistake. Below it the stepper is a plain single column, with no
     track floor for a grid parent's min-content width to absorb. */
  @media (min-width: 1100px) {
    .steps-2 { grid-template-columns: 1fr 1fr; }
  }

  /* NO BULLETS, AND A BOLD LEAD LINE (Andrey, 12 Aug 2026). The discs are gone: they were the same
     maroon marker `ModuleRows` uses for learning outcomes, which was the right call while the step
     was an unfilled row in a list of rows. Inside a bordered card the disc is a third level of
     furniture — card, dotted title rule, then a bulleted list — and the card already does the
     separating the bullets were doing.

     The first line takes --ink at 600 and the rest stay --ink-3. The lead sentence of a step is the
     answer ("Pay $179 and get instant access") and the rest is qualification, so weight promotes the
     answer without spending a colour on it. This is the same shape the hero ticks already use.

     THIS ONLY REACHES HALF THE STEPS, and that is a content fact rather than a CSS one. A step body
     is either an array (rendered as this list, where `:first-child` is a real element) or a single
     string (rendered as one `<p>`, with nothing to promote). Measured across `dist/`: 50 steps on 10
     pages have list bodies, 49 steps on 17 pages are single strings and show no lead emphasis at all.
     Making it universal means authoring those 49 into two-item bodies, which is build work and is on
     the demand list. */
  .step-points{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:4px; }
  .step-points li{ color:var(--ink-3); font-size:16px; line-height:1.55; }
  .step-points li:first-child{ color:var(--ink); font-weight:600; }
</style>
