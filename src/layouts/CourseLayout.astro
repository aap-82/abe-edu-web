---
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WayfinderNav from '../components/WayfinderNav.astro';
import CtaBand from '../components/CtaBand.astro';
import Section from '../components/Section.astro';
import PartnerDisclosure from '../components/PartnerDisclosure.astro';
import FactGrid from '../components/FactGrid.astro';
import CpdMatrix from '../components/CpdMatrix.astro';
import BundleOffer from '../components/BundleOffer.astro';
import SourcesFooter from '../components/SourcesFooter.astro';
import { getEntries } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { imageUrlAbs } from '../lib/images';

interface Props { course: CollectionEntry<'courses'>['data']; }
const { course } = Astro.props;
const {
  title, description, canonical, ogImage,
  nav, cta, sticky, hero, ctaBand, footerSources, disclaimersHtml,
  courseName, courseDescription, priceNumber, courseWorkload, courseMode,
  credentialName, credentialCategory, regulator, breadcrumb, reviewedBy, experts,
  authorityModel, partnerRto, cpd,
} = course;

// `experts` are typed references into the `experts` collection, so resolve them before
// building the Person nodes. Same pattern HubLayout uses for its course spokes.
const expertEntries = await getEntries(experts);
const expertData = expertEntries.map((e) => e.data);

// WHO DID WHAT ON THIS COURSE, read off the experts collection's own per-course `role`
// ("Course developer" / "Compliance and currency review") rather than guessed from a name.
// The record is the one place that already answers this, and it answers it per course:
// Dominic develops QLD/WA/ACT but not TAS, so a name match would credit him on a page he
// had no hand in. Falls back to `reviewedBy.name` (the pattern ExpertCredentials uses) only
// when no role is recorded.
//
// The slug comes off the canonical because the layout is handed `data`, not the entry, so it
// has no id of its own. Safe: every course id equals its canonical slug, verified across all
// 11 course files, and a miss just leaves the edge off rather than pointing it somewhere wrong.
const slug = new URL(canonical).pathname.replace(/^\//, '');
const roleOn = (e: (typeof expertEntries)[number]) =>
  e.data.courses?.find((c) => c.course.id === slug)?.role ?? '';
const developer = expertEntries.find((e) => /developer/i.test(roleOn(e)));
const reviewer = expertEntries.find((e) => /review/i.test(roleOn(e)))
  ?? expertEntries.find((e) => e.data.name === reviewedBy?.name);

// "2 June 2026" -> "2026-06-02". Returns null on anything it does not fully recognise, so an
// unparsed date is OMITTED rather than emitted wrong. A confidently wrong freshness signal is
// worse than an absent one, and this is the same "never default a fact" rule the register runs on.
const MONTHS = ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september', 'october', 'november', 'december'];
const isoDate = (d?: string) => {
  const m = d?.trim().match(/^(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})$/);
  const mi = m ? MONTHS.indexOf(m[2].toLowerCase()) : -1;
  return m && mi !== -1
    ? `${m[3]}-${String(mi + 1).padStart(2, '0')}-${String(Number(m[1])).padStart(2, '0')}`
    : null;
};
// The reviewer's own dated entry for THIS course first, falling back to the page's `reviewedBy`.
// Both say the same thing by design (see the note on `courses[].date` in content.config.ts).
const dateModified = isoDate(
  reviewer?.data.courses?.find((c) => c.course.id === slug)?.date ?? reviewedBy?.date,
);

// A site-wide identity for the publisher, so `provider` on thirteen course pages is ONE entity
// rather than thirteen anonymous organisations that happen to share a name. No `sameAs`: ABE
// Education's verified profile URLs are not recorded anywhere in the repo, and inventing them
// would be a fabricated identity claim on the one node whose job is establishing who ABE is.
const orgId = 'https://www.abeeducation.edu.au/#organization';

// CPD branch. The points-by-licence fact block reuses FactGrid (4 facts, matching its
// grid); the approval reference is a real government listing, so it links out rather
// than sitting inert inside the grid. matrix and bundle are each optional: not every
// CPD course needs a cross-state comparison or an upsell.
const cpdFacts = cpd ? [
  { key: 'CPD points', value: cpd.points },
  { key: 'Licence classes', value: cpd.licenceClasses.join(' · ') },
  { key: 'Renewal', value: cpd.renewalPeriod },
  { key: 'Approved by', value: cpd.approvalRef.label },
] : [];

// ASQA branch. The schema guarantees partnerRto exists iff the model is asqa-accredited,
// but the layout still guards on both so a template change cannot render a partner block
// without a partner. The RTO partner delivers and issues the credential; ABE publishes.
const asqa = authorityModel === 'asqa-accredited' && partnerRto ? partnerRto : null;
// Placement is read off the block itself so the two can differ. A page carrying both a cpd
// object and an asqa partner is unusual but not impossible, and there is no reason they
// should be forced to the same position. `asqa` is partnerRto passed through by reference
// (line above), not reshaped, so `placement` and `eyebrow` carry through unchanged.
const cpdPlacement = cpd?.placement ?? 'after-body';
const rtoPlacement = asqa?.placement ?? 'after-body';
const asqaCredential = asqa?.credential ?? 'Statement of Attainment';
// The per-course ASQA footer legal disclosure (location 3 of the 7 the ASQA disclosure
// framework requires per course page), owned by the layout so no ASQA page can ship without
// it. Prepended to the page's own disclaimers in the Sources footer.
//
// Worded to the framework's prescribed form: it frames ABE positively as the "authorised
// third-party enrolment partner" rather than repeating "ABE is not a registered training
// organisation". That "not an RTO" statement is still made twice on the page - by the
// SITEWIDE compliance footer (.f-asqa in SourcesFooter, a separate required disclosure) and
// by the #rto-partner PartnerDisclosure section - so nothing is lost; this just stops the
// footer stating it two ways four lines apart.
const asqaDisclaimer = asqa
  ? `<p>This website is operated by ABE Education (ABN 64 125 455 272) as an authorised third-party enrolment partner. This course is delivered and assessed by ${asqa.name}, a nationally recognised Registered Training Organisation (RTO ${asqa.rtoNumber}) accredited by the Australian Skills Quality Authority (ASQA), which issues the ${asqaCredential} on completion.</p>`
  : '';

// Absolute URL for the hero image, for the Course ImageObject (multimodal SEO). imageUrlAbs resolves a
// migrated local hero to its hashed same-origin URL and absolutises it against the canonical; an
// un-migrated path/URL passes through unchanged.
const heroImg = imageUrlAbs(hero.artefactImg, canonical) ?? null;

// Single server-rendered JSON-LD @graph, built from typed frontmatter.
// recognizedBy is conditional on the authority model (state-approved only).
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Course', '@id': canonical + '#course', name: courseName,
      description: courseDescription,
      provider: { '@type': 'Organization', '@id': orgId, name: 'ABE Education', url: 'https://www.abeeducation.edu.au' },
      // THE GRAPH'S EDGES. Without these the credential and both experts are valid nodes that
      // no machine can connect to the course: the E-E-A-T is fully stated in prose ("Reviewed by
      // Warwick Smith on 2 June 2026") and completely invisible to a parser. Named as the highest
      // -value structured-data fix in the 12 Aug 2026 SEO/AEO audit of this page, and it applies
      // to every course page, not just the one audited.
      educationalCredentialAwarded: { '@id': canonical + '#credential' },
      // `author` is the COURSE DEVELOPER, and on an asqa-accredited page that is never an ABE
      // Education person: the RTO partner develops and owns the accredited course, and is already
      // credited via `creator` above. Crediting an ABE person here would be the exact authority-model
      // breach kb/rules/authority-model.md sect 6 forbids, so the model gates it rather than relying on
      // no developer happening to be listed.
      ...(!asqa && developer ? { author: { '@id': developer.data.canonical + '#person' } } : {}),
      // `reviewedBy` is valid on BOTH models - an independent compliance reviewer reviews the
      // published page regardless of who developed the course.
      ...(reviewer ? { reviewedBy: { '@id': reviewer.data.canonical + '#person' } } : {}),
      // Recency is one of the few signals answer engines weight explicitly, and it was expressed
      // only in prose. No `datePublished`: nothing in the repo records when each course page first
      // went live, and a guessed publication date is a fabricated claim about the page's own history.
      ...(dateModified ? { dateModified } : {}),
      // asqa-accredited: the RTO partner develops, owns and delivers the accredited course under the
      // Standards for RTOs. ABE develops nothing here, so the course is credited to the RTO as its
      // creator (developer) and provider — never to ABE or an ABE person. For state-approved-direct
      // and knowledge-requirement courses ABE IS the developer, so no creator override is added.
      ...(asqa ? { creator: { '@type': 'Organization', name: asqa.name, identifier: `RTO ${asqa.rtoNumber}`, ...(asqa.url ? { url: asqa.url } : {}) } } : {}),
      inLanguage: 'en-AU',
      ...(heroImg ? { image: { '@type': 'ImageObject', contentUrl: heroImg, caption: hero.artefactAlt, inLanguage: 'en-AU' } } : {}),
      offers: { '@type': 'Offer', price: priceNumber, priceCurrency: 'AUD', category: 'Tuition', availability: 'https://schema.org/InStock', url: canonical },
      // courseMode was hardcoded 'online' for every course until 16 Aug 2026, including
      // /white-card-act, which AlertForce delivers face-to-face in a classroom — structured data
      // contradicting the page's own H1. The fallback stays 'online' because that is true of every
      // other course page, and the frontmatter field is optional so setting it is a decision rather
      // than a default somebody inherited. See content.config.ts for why the Zoom-delivered QLD and
      // NSW pages deliberately do NOT set it.
      hasCourseInstance: { '@type': 'CourseInstance', courseMode: courseMode ?? 'online', ...(courseWorkload ? { courseWorkload } : {}) },
    },
    {
      '@type': 'EducationalOccupationalCredential', '@id': canonical + '#credential',
      name: credentialName, credentialCategory,
      // state-approved-direct: the regulator recognises the credential (QLD/TAS yes, WA no).
      // asqa-accredited: the RTO partner is credited as the issuing organisation — never ABE.
      ...(regulator ? { recognizedBy: { '@type': 'GovernmentOrganization', name: regulator.name, url: regulator.url } } : {}),
      ...(asqa ? { recognizedBy: { '@type': 'Organization', name: asqa.name, identifier: `RTO ${asqa.rtoNumber}`, ...(asqa.url ? { url: asqa.url } : {}) } } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: b.item })),
    },
    // Field order below was load-bearing during the frontmatter refactor: it kept the rendered
    // JSON-LD byte-identical to the pre-refactor output. `@id` is a DELIBERATE addition on top of
    // that (12 Aug 2026), so the output is no longer byte-identical by design; the existing fields
    // keep their order and nothing else moves.
    //
    // The @id is the PERSON'S OWN PROFILE canonical, not a fragment of this course URL. That is
    // what makes Dominic on /qld-owner-builder-course, on /wa-owner-builder-course and on his own
    // profile page one entity instead of three look-alikes, and it is what `author`/`reviewedBy`
    // above point at. Taken from the record's `canonical` rather than built from the id, so the
    // profile page and the graph can never disagree about where a person lives.
    ...expertData.map((e) => ({
      '@type': 'Person', '@id': e.canonical + '#person', name: e.name, jobTitle: e.jobTitle,
      ...(e.portrait ? { image: imageUrlAbs(e.portrait.src, canonical) } : {}),
      sameAs: e.linkedin,
    })),
  ],
};
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  sticky={sticky}
  authority={course.authorityModel}
  ogImage={ogImage}
  noindex={course.noindex}
  crumbs={breadcrumb}
  reviewed={reviewedBy}
>
<main id="main">
  <Hero {...hero} cta={cta} />
  {/* Jump nav sits below the hero: it only sticks once you scroll past it. */}
  <WayfinderNav items={nav} cta={cta} />
  {/* Layout-owned blocks render either side of the body, per each block's own `placement`.
      The two branches are mutually exclusive, so every id appears at most once at runtime. */}
  {cpd && cpdPlacement === 'after-hero' && (
    <>
      <Section id="cpd-points" bg="bg-alt" eyebrow={cpd.headings.points.eyebrow} h2={cpd.headings.points.h2}>
        <FactGrid items={cpdFacts} />
        <p class="cpd-approval-note">Listed as an approved CPD activity by <a href={cpd.approvalRef.href}>{cpd.approvalRef.label}</a>.</p>
      </Section>
      {cpd.matrix && (
        <Section id="cpd-matrix" eyebrow={cpd.headings.matrix.eyebrow} h2={cpd.headings.matrix.h2}>
          <CpdMatrix states={cpd.matrix.states} rows={cpd.matrix.rows} caption={cpd.matrix.caption} />
        </Section>
      )}
      {cpd.bundle && (
        <Section id="cpd-bundle" bg="bg-alt" eyebrow={cpd.headings.bundle.eyebrow} h2={cpd.headings.bundle.h2}>
          <BundleOffer {...cpd.bundle} />
        </Section>
      )}
    </>
  )}

  {asqa && rtoPlacement === 'after-hero' && (
    <Section id="rto-partner" bg="bg-alt" eyebrow={asqa.eyebrow}>
      {/* h2, not h3: after-hero this is the FIRST heading below the h1, so an h3 skips a level
          (WCAG 1.3.1). class="h3" still carries the visual, so nothing moves. */}
      <PartnerDisclosure partner={asqa.name} rto={asqa.rtoNumber} units={asqa.units} credential={asqaCredential} headingLevel={2} />
    </Section>
  )}

  <slot />

  {cpd && cpdPlacement === 'after-body' && (
    <>
      <Section id="cpd-points" bg="bg-alt" eyebrow={cpd.headings.points.eyebrow} h2={cpd.headings.points.h2}>
        <FactGrid items={cpdFacts} />
        <p class="cpd-approval-note">Listed as an approved CPD activity by <a href={cpd.approvalRef.href}>{cpd.approvalRef.label}</a>.</p>
      </Section>
      {cpd.matrix && (
        <Section id="cpd-matrix" eyebrow={cpd.headings.matrix.eyebrow} h2={cpd.headings.matrix.h2}>
          <CpdMatrix states={cpd.matrix.states} rows={cpd.matrix.rows} caption={cpd.matrix.caption} />
        </Section>
      )}
      {cpd.bundle && (
        <Section id="cpd-bundle" bg="bg-alt" eyebrow={cpd.headings.bundle.eyebrow} h2={cpd.headings.bundle.h2}>
          <BundleOffer {...cpd.bundle} />
        </Section>
      )}
    </>
  )}

  {asqa && rtoPlacement === 'after-body' && (
    <Section id="rto-partner" bg="bg-alt" eyebrow={asqa.eyebrow}>
      {/* h2 for the same reason as the after-hero branch: this card is a top-level section, a peer
          of the page sections around it, not a subsection of the one above it. */}
      <PartnerDisclosure partner={asqa.name} rto={asqa.rtoNumber} units={asqa.units} credential={asqaCredential} headingLevel={2} />
    </Section>
  )}
  <CtaBand headingHtml={ctaBand.headingHtml} sub={ctaBand.sub} cta={ctaBand.cta} />
</main>
  <SourcesFooter sources={footerSources} disclaimersHtml={asqaDisclaimer + disclaimersHtml} asqa={!!asqa} />
</BaseLayout>
