// The five-state table, items-as-rows: facts across the top, states down the side.
// `rows[].href`/`soon` deliberately unset - setting either renders a trailing action
// column, and there is no per-state destination to send anyone to.
const stateColumns = [
  { key: 'compulsory', label: 'Warranty cover compulsory?', width: '26%' },
  { key: 'applies', label: 'What actually applies' },
];

const stateRows = [
  {
    label: 'Queensland',
    values: [
      'No',
      'Owner builders are excluded from the Queensland Home Warranty Scheme by law, so the cover is not available to you rather than merely optional.',
    ],
  },
  {
    label: 'Western Australia',
    values: [
      'Only if you sell within 7 years',
      'Home indemnity insurance is required before settlement if you sell within seven years of the building permit being granted, on work valued over $20,000.',
    ],
  },
  {
    label: 'Australian Capital Territory',
    values: [
      'No',
      'The statutory warranty that the $12,000 threshold triggers for licensed builders expressly excludes work carried out by a licensed owner-builder.',
    ],
  },
  {
    label: 'Tasmania',
    values: [
