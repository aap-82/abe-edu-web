// No Course node and no offers: nothing on this page is purchasable, and asserting a
// product that does not exist is the same class of error as an RTO claim. Article +
// BreadcrumbList + the one reviewer Person.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${canonical}#article`,
      // Matches the rendered <h1> exactly, minus its decorative full stop. A headline that
      // disagrees with the visible heading is a mismatch Google resolves against the page.
      headline: 'Owner builder insurance, and what your state actually requires',
      description: 'Which insurance an owner builder must hold in Queensland, Western Australia, the ACT, Tasmania and New South Wales, and which is optional. Every state position sourced and dated.',
      inLanguage: 'en-AU',
      dateModified: '2026-08-08',
      isPartOf: { '@type': 'WebSite', url: 'https://www.abeeducation.edu.au' },
      publisher: {
        '@type': 'EducationalOrganization',
        name: 'ABE Education',
        url: 'https://www.abeeducation.edu.au',
      },
      // A reference to the Person node below, not a second copy of it. Inlining the whole
      // Person here emitted two Person objects describing one person, which reads as two
      // reviewers to anything counting nodes.
      reviewedBy: { '@id': `${canonical}#reviewer` },
    },
    {
      '@type': 'Person',
      '@id': `${canonical}#reviewer`,
      name: 'Warwick Smith',
      jobTitle: 'Compliance & Currency Reviewer',
      description: 'Independent compliance and currency reviewer, with over 27 years in the Australian vocational education and training sector.',
      sameAs: 'https://www.linkedin.com/in/warwick-a-l-smith/',
